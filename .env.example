# Copy this file to .env and fill in real values. Never commit .env.

# --- DagsHub / MLflow ---
MLFLOW_TRACKING_URI=https://dagshub.com/<your-dagshub-user>/<ROLL>_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=<your-dagshub-user>
MLFLOW_TRACKING_PASSWORD=<your-dagshub-access-token>
DAGSHUB_USER_TOKEN=<your-dagshub-access-token>
# --- training ---
SEED=42
IMG_SIZE=160
BATCH_SIZE=32
DATA_DIR=data/raw

# --- serving ---
MODEL_PATH=models/champion.keras
DECISION_THRESHOLD=0.5
MAX_UPLOAD_MB=5
FLASK_SECRET_KEY=change-me-to-something-random

# Remote model API (Task 7 / Task 8). Leave MODEL_API_URL empty to run
# inference locally inside the Flask process instead.
MODEL_API_URL=https://<your-cloud-host>/predict
MODEL_API_KEY=<a-long-random-string>

# --- database (Task 5) ---
# For the local SQLite run:
DATABASE_URL=sqlite:///visionguard.db
# For the Compose Postgres run the web service uses this instead:
# DATABASE_URL=postgresql://visionguard:<password>@db:5432/visionguard
POSTGRES_DB=visionguard
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=<pick-a-strong-password>
